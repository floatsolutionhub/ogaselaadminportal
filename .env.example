# Copy to .env.local (gitignored by Vite's default .gitignore) and adjust if the API isn't on
# localhost:8080 (docker-compose's default). Must already include the /api/v1 version prefix -
# every API call in this app is written relative to it (e.g. api.get("/admin/dashboard")).
VITE_API_BASE_URL=http://localhost:8080/api/v1
